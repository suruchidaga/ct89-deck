# Simplest: use Zerodha's Kite MCP server for everything (no Kite Connect app needed).
# The server opens Zerodha's login page; you log in with your password + TOTP.
KITE_SOURCE=mcp

# Or a Kite Connect app from https://developers.kite.trade/apps (remove KITE_SOURCE above to use it).
# The free "Personal" plan is enough when Dhan provides market data below.
# Set the app's redirect URL to http://127.0.0.1:5000/callback
KITE_API_KEY=
KITE_API_SECRET=

# Optional: Dhan Data API for live prices, OI, volume, option chain and IV.
# web.dhan.co > My Profile > Access DhanHQ APIs: copy your Client ID and generate an access token.
# Access tokens expire, so paste a new one here when the dashboard reports it as rejected.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
